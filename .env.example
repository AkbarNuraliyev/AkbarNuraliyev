# Local development configuration — never commit real secrets
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/poultryos?schema=public&connection_limit=10"
APP_URL="http://localhost:3000"
# 32+ random bytes, used to encrypt integration credentials at rest (AES-256-GCM)
APP_ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"
# Shared secret for /api/cron/checks
CRON_SECRET="generate-a-random-secret"
# Optional SMTP (if unset, emails are stored in the outbox with status NOT_SENT)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="PoultryOS <no-reply@poultryos.local>"
