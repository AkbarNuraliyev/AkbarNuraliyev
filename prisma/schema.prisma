  limitMinC    Float?
  limitMaxC    Float?
  recordedById String?
  createdAt    DateTime        @default(now())
  vehicle      Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: NoAction)
  chamber      StorageChamber? @relation(fields: [chamberId], references: [id], onDelete: NoAction)
  shipment     Shipment?       @relation(fields: [shipmentId], references: [id], onDelete: NoAction)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, recordedAt])
  @@index([tenantId, chamberId, recordedAt])
  @@index([tenantId, shipmentId])
  @@map("temperature_readings")
}

