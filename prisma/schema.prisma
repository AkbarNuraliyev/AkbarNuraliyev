  @@map("delivery_routes")
}

model Shipment {
  id               String               @id @default(cuid())
  tenantId         String
  number           String
  vehicleId        String
  driverId         String
  routeId          String?
  status           ShipmentStatus       @default(PLANNED)
  temperatureMode  StorageType          @default(CHILLED)
  plannedDeparture DateTime
  departedAt       DateTime?
  arrivedAt        DateTime?
  notes            String?
  createdById      String?
  createdAt        DateTime             @default(now())
  vehicle          Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: NoAction)
  driver           Driver               @relation(fields: [driverId], references: [id], onDelete: NoAction)
  route            DeliveryRoute?       @relation(fields: [routeId], references: [id], onDelete: NoAction)
  stops            ShipmentOrder[]
  readings         TemperatureReading[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
  @@index([tenantId, plannedDeparture])
  @@map("shipments")
}

model ShipmentOrder {
  id          String     @id @default(cuid())
  tenantId    String
