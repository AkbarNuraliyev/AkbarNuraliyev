  entityType  String?
  entityId    String?
  description String
  quantityKg  Float?
  location    String?
  userId      String?
  occurredAt  DateTime
  batch       ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, batchId, occurredAt])
  @@map("batch_traceability")
}

model Recall {
  id            String          @id @default(cuid())
  tenantId      String
  number        String
  batchId       String
  reason        String
  status        RecallStatus    @default(OPEN)
  initiatedById String?
  initiatedAt   DateTime
  closedAt      DateTime?
  blockedKg     Float           @default(0)
  batch         ProductionBatch @relation(fields: [batchId], references: [id], onDelete: NoAction)
  actions       RecallAction[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
  @@map("recalls")
}

model RecallAction {
  id          String   @id @default(cuid())
  tenantId    String
  recallId    String
  actionType  String
  description String
  userId      String?
  userName    String?
  createdAt   DateTime @default(now())
  recall      Recall   @relation(fields: [recallId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, recallId])
  @@map("recall_actions")
}

// ───────────────────────────── Documents, integrations, notifications, audit ─────────────────────────────

model Document {
  id           String   @id @default(cuid())
  tenantId     String
  type         String
  title        String
  fileName     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  entityType   String?
  entityId     String?
  isPublic     Boolean  @default(false)
  uploadedById String?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@map("documents")
}

model Integration {
  id              String            @id @default(cuid())
  tenantId        String
  provider        String
  status          IntegrationStatus @default(NOT_CONNECTED)
  enabled         Boolean           @default(false)
  config          Json              @default("{}")
  encryptedSecret String?
  lastTestedAt    DateTime?
  lastSyncAt      DateTime?
  lastError       String?
  updatedAt       DateTime          @updatedAt
  createdAt       DateTime          @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@map("integrations")
}

model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  prefix      String
  keyHash     String    @unique
  scopes      String[]
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

model Webhook {
  id              String            @id @default(cuid())
  tenantId        String
  url             String
  events          String[]
  encryptedSecret String
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  deliveries      WebhookDelivery[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  tenantId     String
  webhookId    String
  event        String
  payload      Json
  status       String
  responseCode Int?
  error        String?
  createdAt    DateTime @default(now())
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("webhook_deliveries")
}

model ScaleReading {
  id         String    @id @default(cuid())
  tenantId   String
  deviceId   String
  weightKg   Float
  stable     Boolean   @default(true)
  readAt     DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, deviceId, readAt])
  @@map("scale_readings")
}

model Notification {
  id         String               @id @default(cuid())
  tenantId   String
  type       String
  severity   NotificationSeverity @default(INFO)
  title      String
  message    String
  entityType String?
  entityId   String?
  link       String?
  dedupeKey  String?
  /// Values for the {placeholders} in title/message; both are English templates translated on display.
  params     Json?
  status     NotificationStatus   @default(OPEN)
  readAt     DateTime?
  resolvedAt DateTime?
  createdAt  DateTime             @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  userEmail  String?
  action     String
  entityType String
  entityId   String?
  summary    String?
  changes    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

// ───────────────────────────── Employees & training ─────────────────────────────

model TrainingCourse {
  id             String           @id @default(cuid())
  tenantId       String
  title          String
  category       String
  description    String?
  validityMonths Int?
  mandatory      Boolean          @default(false)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  records        TrainingRecord[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("training_courses")
}

model TrainingRecord {
  id           String         @id @default(cuid())
  tenantId     String
  courseId     String
  userId       String?
  employeeName String
  completedAt  DateTime
  expiresAt    DateTime?
  score        Float?
  trainer      String?
  notes        String?
  createdById  String?
  createdAt    DateTime       @default(now())
  course       TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, courseId])
  @@map("training_records")
}
